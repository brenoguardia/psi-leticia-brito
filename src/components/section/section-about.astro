---
import avatar from '@/assets/images/avatar_2.jpg';
import avatarWebp from '@/assets/images/avatar_2.webp';
import { ABOUT_MOCK } from '@/mock';
import { Image } from 'astro:assets';
import Icon from '../icon/icon.astro';
import SectionContent from './section.astro';

const aboutData = ABOUT_MOCK;
---

<SectionContent
  theme="dark"
  class="bg-transparent py-24"
  id="sobre"
>
  <div
    class="mx-auto flex max-w-7xl flex-col items-center gap-20 px-8 lg:flex-row"
  >
    <div class="w-full lg:w-5/12">
      <div class="group relative">
        <div
          class="absolute inset-0 translate-x-4 translate-y-4 rounded-[2rem] bg-editorial-primary/5 transition-transform duration-500 group-hover:translate-x-6 group-hover:translate-y-6"
          aria-hidden="true"
        >
        </div>
        <picture>
          <source srcset={avatarWebp.src} type="image/webp" />
          <Image
            src={avatar}
            alt="Psicóloga Letícia Brito"
            loading="lazy"
            class="relative z-10 aspect-[1/1.2] w-full rounded-[2rem] object-cover shadow-lg"
          />
        </picture>
      </div>
    </div>

    <div class="w-full space-y-6 lg:w-7/12">
      <h2 class="font-headline text-4xl leading-tight text-editorial-primary">
        {aboutData.title}
      </h2>

      <div
        class="space-y-4 text-lg leading-relaxed text-editorial-on-surface-variant"
      >
        <p set:html={aboutData.description} />
      </div>

      <div class="pt-6">
        {
          aboutData.items.map((item, index) => (
            <div class="flex items-start gap-3 w-full">
              <Icon
                name={item.icon}
                class="mt-0.5 size-7 text-editorial-primary"
              />
              <div>
                <h4 class="font-bold text-editorial-on-surface">
                  {item.title}
                </h4>
                <p class="text-sm text-editorial-on-surface-variant">
                  {item.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</SectionContent>
