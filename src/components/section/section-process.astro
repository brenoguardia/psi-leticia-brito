---
import { PROCESS_MOCK } from '@/mock';
import Icon from '../icon/icon.astro';
import SectionContent from './section.astro';

const processData = PROCESS_MOCK;
---

<SectionContent
  theme="light"
  class="bg-editorial-surface-container-lowest py-24"
  id="atendimento"
>
  <div class="mx-auto max-w-7xl px-8">
    <div class="mx-auto mb-20 max-w-2xl text-center">
      <h2 class="mb-6 font-headline text-4xl text-editorial-primary">
        {processData.title}
      </h2>
      <p class="text-editorial-on-surface-variant">
        {processData.description}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-12 md:grid-cols-3">
      {
        processData.steps.map((step, index) => (
          <div class="group relative rounded-xl p-8 transition-all duration-300 hover:bg-editorial-surface-container-low">
            <div class="mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-editorial-primary-fixed text-editorial-primary-container transition-transform group-hover:scale-110">
              <Icon name={step.icon} class="size-8" />
            </div>
            <h3 class="mb-3 text-xl font-bold text-editorial-on-surface">
              {step.title}
            </h3>
            <p class="leading-relaxed text-editorial-on-surface-variant">
              {step.description}
            </p>
            {index < processData.steps.length - 1 && (
              <div
                class="absolute -right-6 top-1/2 hidden -translate-y-1/2 text-editorial-outline-variant/30 md:block"
                aria-hidden="true"
              >
                <Icon name="ArrowRight" class="size-12" />
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>
</SectionContent>
