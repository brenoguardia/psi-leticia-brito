---
import { SERVICES_MOCK, servicesMock } from "@/mock";
import Icon from "../icon/icon.astro";
import SectionContent from "./section.astro";

const servicesData = SERVICES_MOCK;
---

<SectionContent
  theme="light"
  class="bg-editorial-surface-container-high py-24"
  id="especialidades"
>
  <div class="mx-auto max-w-7xl px-8">
    <div
      class="mb-16 flex flex-col items-end justify-between gap-8 md:flex-row"
    >
      <div class="max-w-xl">
        <h2 class="mb-4 font-headline text-4xl text-editorial-primary">
          {servicesData.title}
        </h2>
        <p class="text-editorial-on-surface-variant">
          {servicesData.description}
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        servicesMock.map((service) => (
          <div class="group rounded-xl border border-editorial-outline-variant/10 bg-editorial-surface-container-lowest p-8 shadow-sm transition-all duration-500 hover:-translate-y-2 hover:shadow-xl">
            <span class="mb-6 block text-4xl text-editorial-primary transition-transform group-hover:rotate-6">
              <Icon
                name={
                  (servicesData.serviceIcons as Record<string, string>)[
                    service.icon
                  ] ?? "Sparkles"
                }
                class="size-9"
              />
            </span>
            <h4 class="mb-3 text-xl font-bold">{service.title}</h4>
            <p class="text-sm leading-relaxed text-editorial-on-surface-variant">
              {service.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</SectionContent>
