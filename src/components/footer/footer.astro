---
import { FOOTER_MOCK } from "@/mock";
import { env } from "@/types/env";
import { Icon as AstroIcon } from "astro-icon/components";
import Icon from "../icon/icon.astro";

const footerData = FOOTER_MOCK;
---

<footer
  class="w-full bg-editorial-surface-container-lowest"
  id="contact"
  data-section-theme="light"
>
  <div class="mx-auto max-w-7xl px-8 py-16">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-4">
      <div class="space-y-6 md:col-span-2">
        <div class="font-serif text-2xl italic text-editorial-primary">
          {footerData.title}
        </div>
        <p
          class="max-w-sm text-editorial-on-surface-variant"
          set:html={footerData.description}
        />
        <div class="flex gap-4">
          <a
            href={footerData.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Link para o instagram"
            class="flex h-10 w-10 items-center justify-center rounded-full bg-editorial-surface-container text-editorial-primary transition-all hover:bg-editorial-primary-container hover:text-white"
          >
            <AstroIcon name="instagram" size={20} />
          </a>
          <a
            href={env.PUBLIC_FACEBOOK_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Link para o facebook"
            class="flex h-10 w-10 items-center justify-center rounded-full bg-editorial-surface-container text-editorial-primary transition-all hover:bg-editorial-primary-container hover:text-white"
          >
            <AstroIcon name="facebook" size={20} />
          </a>
        </div>
      </div>

      <div>
        <h5 class="mb-6 font-bold text-editorial-primary">
          {footerData.menus.links.text}
        </h5>
        <ul class="space-y-4 text-sm text-editorial-on-surface-variant">
          {
            footerData.menus.links.items.map((item) => (
              <li>
                <a
                  class="transition-colors hover:text-editorial-primary"
                  href={item.href}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h5 class="mb-6 font-bold text-editorial-primary">
          {footerData.menus.about.text}
        </h5>
        <ul class="space-y-4 text-sm text-editorial-on-surface-variant">
          {
            footerData.menus.about.items.map((item) => (
              <li class="flex items-start gap-2">
                {item.icon && (
                  <Icon
                    name={item.icon}
                    class="mt-0.5 size-4 shrink-0 text-editorial-primary"
                  />
                )}

                {item?.href ? (
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="transition-colors hover:text-editorial-primary"
                  >
                    {item.label}
                  </a>
                ) : (
                  <span>{item.label}</span>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <div
    class="flex flex-col items-center justify-between gap-6 border-t border-editorial-outline-variant/40 pt-12 md:flex-row"
  >
    <p class="text-sm text-editorial-on-surface-variant">
      {footerData.others.text}
    </p>
    <p class="text-sm text-editorial-on-surface-variant">
      {footerData.others.codeIdentity}
    </p>
  </div>
</footer>
